PROFIT..  - 100*X(Trucks) - 110*X(Sedans) + VPROFIT =E= 0 ; (LHS = 0)
     

---- RES_CONSTRAIN  =L=  Resource Constraints

RES_CONSTRAIN(Fuel_Tanks)..  2*X(Trucks) + X(Sedans) =L= 14000 ; (LHS = 0)
     
RES_CONSTRAIN(Seats)..  X(Trucks) + 2*X(Sedans) =L= 18000 ; (LHS = 0)
     
